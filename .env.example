# Copy to .env and fill in what you use. Everything is optional.

# AI narrative analysis (one is enough)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Override model IDs if a default is retired (defaults shown)
# CLAUDE_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-2.5-flash

# Gate the AI buttons behind a password (recommended on any public deployment).
# Use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# AI_PASSWORD=

# Vegas implied team totals (free tier at https://the-odds-api.com)
ODDS_API_KEY=

# Override the default leagues in config.toml
# SLEEPER_USERNAME=
# SLEEPER_LEAGUE_IDS=id1,id2
# SLEEPER_AUTO_SYNC_MINUTES=30
